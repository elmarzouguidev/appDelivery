{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1|^8.2",
        "barryvdh/laravel-dompdf": "^2.0",
        "brick/money": "^0.7.0",
        "doctrine/dbal": "^3.5",
        "guzzlehttp/guzzle": "^7.0.1",
        "abordage/laravel-html-min": "^0.2.0",
        "jackiedo/dotenv-editor": "^2.0",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^10.19",
        "laravel/sanctum": "^3.0",
        "laravel/telescope": "^4.9",
        "laravel/scout": "^9.4",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^4.1",
        "laraveldaily/laravel-charts": "^0.1.29",
        "livewire/livewire": "^2.10",
        "lorisleiva/laravel-actions": "^2.4",
        "maatwebsite/excel": "^3.1",
        "predis/predis": "^1.1",
        "propaganistas/laravel-phone": "^5.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/cpu-load-health-check": "^1.0",
        "spatie/laravel-backup": "^8.1",
        "spatie/laravel-collection-macros": "^7.11",
        "spatie/laravel-health": "^1.8",
        "spatie/laravel-honeypot": "^4.3",
        "spatie/laravel-medialibrary": "^10.5",
        "spatie/laravel-permission": "^5.5",
        "spatie/laravel-query-builder": "^5.0",
        "spatie/laravel-settings": "^2.5",
        "staudenmeir/eloquent-eager-limit": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.7",
        "barryvdh/laravel-ide-helper": "^2.12",
        "brianium/paratest": "^6.3",
        "fakerphp/faker": "^1.9.1",
        "laravel/envoy": "^2.8",
        "laravel/pint": "^1.6",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "nunomaduro/larastan": "^2.0",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": ["app/helpers.php"]

    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-ide-helper"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
